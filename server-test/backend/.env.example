# Backend Server Environment Variables
# Copy this file to .env and adjust values for your environment

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=finalproject
MONGO_USER=
MONGO_PASS=

# MySQL/PostgreSQL Configuration (if using SQL instead of MongoDB)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=app_db

# SQLite Configuration (if using SQLite)
SQLITE_FILENAME=./data/sqlite.db

# File Upload Configuration
UPLOAD_DIR=uploads

# Data Files
DOMAINS_FILE=domains.json
DATABASES_FILE=databases.json

# Apache/Web Server Configuration
APACHE_SITES_AVAILABLE=/etc/apache2/sites-available
APACHE_SITES_ENABLED=/etc/apache2/sites-enabled
APACHE_SERVICE_NAME=apache2
APACHE_ACCESS_LOG_DIR=/var/log/apache2
APACHE_BANLIST_FILE=apache-banlist.json
APACHE_BAN_CONF_PATH=/etc/apache2/conf-available/finalproject-ip-blocklist.conf
WEB_ROOT=/var/www/html

# PHP Configuration
PHP_FPM_SOCKET_PATH=/run/php

# CORS Origin (for production, set to specific frontend URL)
CORS_ORIGIN=*
