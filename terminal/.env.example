# Terminal Server Environment Variables
# Copy this file to .env and adjust values for your environment

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# Shell Configuration
DEFAULT_SHELL=bash
DEFAULT_CWD=
